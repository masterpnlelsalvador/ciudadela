        }
      }
    },
    {
      "parameters": {
        "chatId": "PEGA-EL-ID-DE-TU-GRUPO",
        "text": "=No se pudo responder al cliente en la conversación {{ $(\"filtro_de_entrada\").item.json.conversacion }}. Revisa la API de la tienda.",
