        540
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram tienda"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.tienda-aurora.example/v1/conversaciones/{{ $('filtro_de_entrada').item.json.conversacion }}/mensajes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ texto: $json.output }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "89c057da-cc54-4820-a7b9-85abf3883f75",
      "name": "responder_al_cliente",
      "type": "n8n-nodes-base.httpRequest",
